          "host": ["localhost"],
          "port": "8004",
          "path": ["api", "v1", "payments"]
        }
      }
    },
    {
      "name": "Get Payment Status",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8004/api/v1/payments/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8004",
          "path": ["api", "v1", "payments", "1"]
